<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Form</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <main class="page-shell">
      <section class="card">
        <h1 class="page-title">Register Student</h1>

        <form action="/submit" method="post" class="user-form">
          <div class="field-group">
            <label for="name">Name</label>
            <input type="text" name="name" id="name" required />
          </div>

          <div class="field-group">
            <label for="age">Age</label>
            <input type="age" name="age" id="age" required />
          </div>

          <div class="field-group">
            <label for="roll">Roll</label>
            <input type="roll" name="roll" id="roll" required />
          </div>

          <div class="field-group">
            <label for="course">Course</label>
            <input type="course" name="course" id="course" required />
          </div>

          <button type="submit" class="submit-btn">Submit</button>
        </form>
      </section>

      <section class="card users-card">
        <h2 class="section-title">Available Students <span>(<%= Array.isArray(students) ? students.length : 0 %>)</span></h2>

        <table class="user-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Age</th>
              <th>Roll</th>
              <th>Course</th>
              <th>Delete</th>
            </tr>
          </thead>
          <tbody>
            <% if (Array.isArray(students) && students.length) { %>
              <% students.map((student, index) => { %>
                <tr>
                  <td><%= student.name %></td>
                  <td><%= student.age %></td>
                  <td><%= student.roll %></td>
                  <td><%= student.course %></td>
                  <td>
                    <form action="/delete" method="post" class="delete-form">
                      <input type="hidden" name="index" value="<%= index %>">
                      <button type="submit" class="delete-btn">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="2">No students yet</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </section>
    </main>
  </body>
</html>
